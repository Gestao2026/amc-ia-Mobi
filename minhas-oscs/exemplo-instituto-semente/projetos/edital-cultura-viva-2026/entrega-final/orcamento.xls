</head><body><h3>Orçamento. Edital Cultura Viva 2026. Oficinas de Música</h3><table><tr><th>Rubrica</th><th>Valor</th><th>% do total</th><th>Teto do edital</th><th>Situação</th></tr><tr><td>Pessoal e encargos</td><td>R$ 96.000,00</td><td>60,0%</td><td>70%</td><td>dentro</td></tr><tr><td>Serviços de terceiros (PJ)</td><td>R$ 18.000,00</td><td>11,3%</td><td>sem teto</td><td>dentro</td></tr><tr><td>Material de consumo</td><td>R$ 14.000,00</td><td>8,8%</td><td>sem teto</td><td>dentro</td></tr><tr><td>Material permanente</td><td>R$ 24.000,00</td><td>15,0%</td><td>30%</td><td>dentro</td></tr><tr><td>Despesas administrativas</td><td>R$ 8.000,00</td><td>5,0%</td><td>10%</td><td>dentro</td></tr><tr><td>Total</td><td>R$ 160.000,00</td><td>100%</td><td>R$ 160.000,00</td><td>no teto</td></tr><tr></tr><tr><th>Item</th><th>Unidade</th><th>Qtde</th><th>Valor unitário</th><th>Valor total</th><th>Memória de cálculo</th></tr><tr><td>Coordenador pedagógico</td><td>mês</td><td>10</td><td>R$ 3.000,00</td><td>R$ 30.000,00</td><td>1 profissional x 20h/sem x 10 meses</td></tr><tr><td>Oficineiros de música</td><td>mês</td><td>40</td><td>R$ 1.200,00</td><td>R$ 48.000,00</td><td>4 oficineiros x 10 meses</td></tr><tr><td>Educador social</td><td>mês</td><td>10</td><td>R$ 1.800,00</td><td>R$ 18.000,00</td><td>1 profissional x 20h/sem x 10 meses</td></tr><tr><td>Gravação e edição das apresentações</td><td>serviço</td><td>4</td><td>R$ 4.500,00</td><td>R$ 18.000,00</td><td>4 apresentações registradas</td></tr><tr><td>Material pedagógico e de consumo</td><td>mês</td><td>10</td><td>R$ 1.400,00</td><td>R$ 14.000,00</td><td>partituras, cordas, baquetas, papelaria</td></tr><tr><td>Instrumentos musicais</td><td>conjunto</td><td>1</td><td>R$ 24.000,00</td><td>R$ 24.000,00</td><td>violões, percussão, teclado, amplificação</td></tr><tr><td>Despesas administrativas</td><td>mês</td><td>10</td><td>R$ 800,00</td><td>R$ 8.000,00</td><td>água, luz, internet, taxa de administração</td></tr><tr></tr><tr><th>Item</th><th>Tipo</th><th>Valor estimado</th></tr><tr><td>Cessão do espaço para oficinas</td><td>não financeira</td><td>R$ 12.000,00</td></tr><tr><td>Equipe administrativa de apoio</td><td>não financeira</td><td>R$ 9.600,00</td></tr><tr></tr><tr><th>Etapa</th><th>Meses</th><th>Valor</th></tr><tr><td>1ª parcela (estruturação)</td><td>1 a 2</td><td>R$ 56.000,00</td></tr><tr><td>2ª parcela (execução)</td><td>3 a 7</td><td>R$ 72.000,00</td></tr><tr><td>3ª parcela (encerramento)</td><td>8 a 10</td><td>R$ 32.000,00</td></tr><tr></tr></table></body></html>