# AMC IA. Variáveis de ambiente
# Copie este arquivo para .env e preencha. O .env NUNCA vai para o git.

# Conexão direta ao banco do CaptaHub (editais via PostgREST). Legado/fallback.
# Configure com /captahub-conectar. Os editais são puxados daqui.
SUPABASE_URL=
SUPABASE_KEY=
CAPTAHUB_EDITAIS_TABLE=editais

# API pública REST do CaptaHub (editais globais + pipeline e clientes por usuário).
# Token pessoal gerado no CaptaHub (aba API). Vai no header Authorization: Bearer.
CAPTAHUB_API_URL=https://pkwwnajskprfutfavylq.supabase.co/functions/v1/api
CAPTAHUB_API_TOKEN=

# Geração de imagens / criativos (opcional, reaproveita o padrão do Fluxo Criativo)
OPENROUTER_API_KEY=

# Envio de alertas de novos editais (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
