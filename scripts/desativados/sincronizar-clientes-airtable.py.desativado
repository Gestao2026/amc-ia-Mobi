def natureza(texto):
    alvo = normalizar(texto)
    if not alvo:
        return None
    for chave, valor in NATUREZAS:
        if chave in alvo:
            return valor
    return "Outra"


def areas(lista):
    encontradas = []
    for item in lista or []:
        alvo = normalizar(item)
        for chave, valor in AREAS:
            if chave in alvo and valor not in encontradas:
                encontradas.append(valor)
    return encontradas


def documentos(bloco):
    encontrados = []
    for chave, valor in (bloco or {}).items():
        if valor is True and chave in DOCUMENTOS:
            if DOCUMENTOS[chave] not in encontrados:
                encontrados.append(DOCUMENTOS[chave])
    return encontrados


def reais(valor):
    return "R$ " + f"{valor:,.2f}".replace(",", "#").replace(".", ",").replace("#", ".")


def montar_campos(cliente):
    campos = {F_OSC: (cliente.get("nome") or "").strip()}
    if cliente.get("cnpj"):
        campos[F_CNPJ] = cliente["cnpj"]
    valor = natureza(cliente.get("natureza_juridica"))
    if valor:
        campos[F_NATUREZA] = valor
    if cliente.get("fundacao"):
        campos[F_FUNDACAO] = cliente["fundacao"]
    if cliente.get("municipio"):
        campos[F_MUNICIPIO] = cliente["municipio"]
    sigla = (cliente.get("uf") or "").strip().upper()
    if sigla:
        extenso = UF_POR_EXTENSO.get(sigla)
        if extenso:
            campos[F_UF] = extenso
        else:
            print(f"  AVISO: {cliente.get('nome')} tem UF {sigla}, que não existe na lista do Airtable. Acrescente a opção na tela.")
    lista = areas(cliente.get("areas_tematicas"))
    if lista:
        # Duas colunas, de propósito. A principal é a primeira que a captadora
        # digitou no CaptaHub e é a que se lê na grade. A lista completa fica
        # oculta e serve para cruzar o cliente com a Categoria do edital.
        campos[F_AREA_PRINCIPAL] = lista[0]
        campos[F_AREAS] = lista
    email = (cliente.get("email") or "").strip()
    if "@" in email:
        campos[F_EMAIL] = email
    if cliente.get("telefone"):
        campos[F_TELEFONE] = cliente["telefone"].strip()
    historico = cliente.get("historico_aprovacoes") or []
    if historico:
        linhas, total = [], 0
        for item in historico:
            valor_item = item.get("valor") or 0
            total += valor_item
            linhas.append(f"{item.get('ano', '')} | {reais(valor_item)} | {item.get('financiador', '')}")
        campos[F_HISTORICO] = "\n".join(linhas)
        campos[F_VALOR_APROVADO] = round(total, 2)
    return campos


class Airtable:
    def __init__(self, token, base_id):
        self.token = token
        self.base_id = base_id

    def _requisicao(self, metodo, caminho, params=None, corpo=None):
        url = f"https://api.airtable.com/v0/{self.base_id}{caminho}"
        if params:
            url += "?" + urllib.parse.urlencode(params)
        dados = json.dumps(corpo).encode("utf-8") if corpo is not None else None
        req = urllib.request.Request(
            url,
            data=dados,
            method=metodo,
            headers={
                "Authorization": f"Bearer {self.token}",
                "Content-Type": "application/json",
            },
        )
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                return json.loads(resp.read().decode("utf-8"))
        except urllib.error.HTTPError as erro:
            detalhe = erro.read().decode("utf-8", "replace")[:300]
            raise SystemExit(f"Airtable respondeu {erro.code}: {detalhe}")

    def listar_clientes(self):
        registros, offset = [], None
        while True:
            params = {"pageSize": 100, "returnFieldsByFieldId": "true"}
            if offset:
                params["offset"] = offset
            resposta = self._requisicao("GET", f"/{TABELA_CLIENTES}", params=params)
            registros.extend(resposta.get("records", []))
            offset = resposta.get("offset")
            if not offset:
                break
        return registros

    def atualizar(self, lote):
        return self._requisicao("PATCH", f"/{TABELA_CLIENTES}", corpo={"records": lote})


def main():
    parser = argparse.ArgumentParser(description="Sincroniza clientes do CaptaHub para o Airtable.")
    parser.add_argument("--simular", action="store_true", help="mostra o que faria, sem gravar")
    args = parser.parse_args()

    env = carregar_env()
    token = env.get("AIRTABLE_TOKEN")
    base_id = env.get("AIRTABLE_BASE_ID")
    if not token or not base_id:
        raise SystemExit(
            "Faltam AIRTABLE_TOKEN e AIRTABLE_BASE_ID no .env.\n"
            "Gere o token em airtable.com/create/tokens com escopos "
            "data.records:read e data.records:write nesta base."
        )

    spec = importlib.util.spec_from_file_location("captahub", RAIZ / "scripts" / "captahub-api.py")
    captahub = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(captahub)
    cliente_api = captahub.CaptaHubClient.from_env()

    print("Puxando a carteira do CaptaHub...")
    do_captahub = list(cliente_api.iter_clientes()) if hasattr(cliente_api, "iter_clientes") else \
        cliente_api.get("/v1/clientes", params={"limit": 200}).get("data", [])
    print(f"  {len(do_captahub)} clientes no CaptaHub.")

    airtable = Airtable(token, base_id)
    print("Lendo a carteira do Airtable...")
    registros = airtable.listar_clientes()
    por_id = {}
    for registro in registros:
        chave = (registro.get("fields") or {}).get(F_ID_CAPTAHUB)
        if chave:
            por_id[chave] = registro["id"]
    print(f"  {len(registros)} clientes no Airtable, {len(por_id)} com ID CaptaHub.")

    lote, ignorados = [], []
    for cliente in do_captahub:
        destino = por_id.get(cliente["id"])
        if not destino:
            ignorados.append(cliente.get("nome") or cliente["id"])
            continue
        lote.append({"id": destino, "fields": montar_campos(cliente)})

    print()
    print(f"Vai atualizar: {len(lote)}")
    if ignorados:
        print(f"Fora da carteira do Airtable, ignorados: {len(ignorados)}")
        for nome in ignorados:
            print(f"  - {nome}")
        print("  (Cliente novo entra na mão. O script nunca cria registro sozinho.)")

    if args.simular:
        print("\nModo simulação. Nada foi gravado.")
        return

    enviados = 0
    for inicio in range(0, len(lote), 10):
        pedaco = lote[inicio : inicio + 10]
        airtable.atualizar(pedaco)
        enviados += len(pedaco)
        print(f"  gravados {enviados}/{len(lote)}")
        time.sleep(0.25)

    print(f"\nConcluído. {enviados} clientes atualizados.")
    print("Campos preservados, nunca escritos por este script:")
    for nome in NUNCA_ESCREVER.values():
        print(f"  - {nome}")


if __name__ == "__main__":
    main()
