# mcp-linkedin. Variáveis de ambiente (exemplo)
#
# Este arquivo lista apenas os NOMES das variáveis previstas no plano
# técnico. Nenhuma delas está implementada ou é lida nesta etapa.
# Nunca preencha valores reais aqui; copie para .env (fora do Git) quando
# a implementação correspondente for autorizada.
#
# Este .env é exclusivo do mcp-linkedin. Nunca deve ser o mesmo .env do
# restante do AMC-IA-Mobi, e o restante do AMC-IA-Mobi nunca deve ler
# estas variáveis.

# --- Camada 2: mcp-linkedin -> LinkedIn (app Mobi) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORGANIZATION_URN=

# --- Camada 1: Claude.ai -> mcp-linkedin ---
# Nomes previstos; o desenho definitivo depende da decisão pendente
# sobre como a Camada 1 será implementada (ver plano técnico).
MCP_LINKEDIN_AUTH_ISSUER_URL=

# --- Armazenamento seguro de token (decisão de infraestrutura pendente) ---
MCP_LINKEDIN_TOKEN_STORE_BACKEND=
