# Ponte de armazenamento dos componentes MCP. Vai no docroot do
# subdominio ponte.mobilizando.org, ao lado dos arquivos token.
#
# ESTE ARQUIVO E COMPARTILHADO. O mesmo .htaccess serve o mcp-linkedin
# e o mcp-instagram, porque os dois vivem no mesmo docroot. Existe uma
# copia identica em mcp-instagram/ponte-hostgator/. Ao mudar um, mude
# o outro: no servidor existe um arquivo so.

# Repassa o cabecalho Authorization para o PHP. Em CGI/FastCGI ele
# costuma ser removido antes de chegar ao script. O token.php nao
# depende disto (aceita tambem X-MCP-Ponte-Secret), mas com esta regra
# os dois formatos funcionam.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Forca HTTPS. O token.php tambem recusa HTTP, mas aqui a
    # requisicao nem chega a ser processada.
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ - [F]
</IfModule>

# Sem listagem de diretorio.
Options -Indexes

# Nada alem dos arquivos token deve ser servido daqui. A lista e
# fechada: um arquivo novo nesta pasta nasce bloqueado ate ser
# acrescentado aqui de proposito.
#
# token.php             mcp-linkedin
# token-instagram.php   mcp-instagram
<FilesMatch "^(?!(token|token-instagram)\.php$).*$">
    Require all denied
</FilesMatch>

# Cinto e suspensorio: se um config.php acabar nesta pasta por engano
# (o lugar correto e um nivel acima), ele nao pode ser baixado.
<FilesMatch "config.*\.php$">
    Require all denied
</FilesMatch>
