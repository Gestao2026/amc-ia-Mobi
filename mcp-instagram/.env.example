# mcp-instagram. Variáveis de ambiente (exemplo)
#
# Este arquivo lista apenas os NOMES das variáveis. Nunca preencha
# valores reais aqui: copie para .env (fora do Git) em desenvolvimento
# local, ou cadastre como secret no painel do Render em produção.
#
# Este .env é exclusivo do mcp-instagram. Nunca deve ser o mesmo .env do
# restante do AMC-IA-Mobi, e o restante do AMC-IA-Mobi nunca deve ler
# estas variáveis.

# --- Transporte ---
# stdio (padrão, uso local) ou streamable-http (produção).
# Em produção, PORT é fornecida automaticamente pelo Render.
MCP_TRANSPORT=
PORT=

# --- Base pública do serviço ---
# URL pública raiz onde este servidor responde, sem barra no final.
# PRECISA ser https:// (a Meta recusa redirect_uri sem HTTPS, e a
# inicialização é abortada se não for).
# Usada pelas DUAS camadas: é o issuer da Camada 1 e a origem do
# redirect_uri da Camada 2 (base + /oauth/instagram/callback).
# Exemplo: https://mcp-instagram.onrender.com
MCP_PUBLIC_BASE_URL=

# --- Camada 1: Claude -> mcp-instagram ---
# Se ausentes, a Camada 1 fica desligada e /mcp responde sem exigir
# autorização (adequado só para uso local via stdio).
MCP_CLAUDE_CLIENT_ID=
MCP_CLAUDE_CLIENT_SECRET=

# --- Camada 2: mcp-instagram -> Instagram (app na Meta) ---
# ID e Secret do aplicativo no painel da Meta, em Configuração da API
# com login do Instagram. Se qualquer uma das duas (ou
# MCP_PUBLIC_BASE_URL) estiver ausente, a Camada 2 fica desligada e o
# servidor sobe sem ela.
#
# O redirect_uri a cadastrar no painel da Meta é exatamente:
#   {MCP_PUBLIC_BASE_URL}/oauth/instagram/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Escopos solicitados. Separe por vírgula ou por espaço (a conversão
# para o formato que a Meta exige é feita no código).
#
# PADRÃO, se esta variável ficar vazia, e é o que foi decidido para esta
# conexão (somente leitura):
#   instagram_business_basic,instagram_business_manage_insights
#
# NÃO acrescente os escopos abaixo sem decisão explícita: eles dão poder
# de escrita na conta ou acesso a conversa privada.
#   instagram_business_content_publish   publicar
#   instagram_business_manage_comments   responder e apagar comentários
#   instagram_business_manage_messages   ler e responder o Direct
#   ads_management                       administrar anúncios
INSTAGRAM_SCOPES=

# Onde guardar o access token do Instagram:
#   windows   desenvolvimento local (Credential Manager / DPAPI).
#             Só funciona no Windows: a configuração é RECUSADA na
#             inicialização em qualquer outro sistema.
#   ponte     produção (recomendado). Ponte HTTPS na HostGator, que
#             grava num MySQL em localhost. O token vai cifrado; a ponte
#             nunca vê a chave. Exige as duas variáveis
#             MCP_INSTAGRAM_PONTE_*.
#   supabase  produção (alternativa). Tabela dedicada, com o token
#             cifrado no aplicativo antes de sair daqui. Exige as três
#             variáveis MCP_INSTAGRAM_SUPABASE_*.
#   memory    testes e uso efêmero. Não sobrevive a reinício.
# Opcional: o padrão é "windows" no Windows e "memory" nos demais.
INSTAGRAM_TOKEN_STORE_BACKEND=

# --- Backend de produção do token (só quando BACKEND=ponte) ---
# Pode ser a MESMA ponte já usada pelo mcp-linkedin: o token.php guarda
# por "alvo", e o alvo deste componente é diferente
# (mcp-instagram:instagram-access-token), então os dois tokens convivem
# sem colidir. Se preferir isolar, publique uma segunda ponte.
# A URL PRECISA ser https:// (http é recusado na inicialização).
MCP_INSTAGRAM_PONTE_URL=

# Segredo compartilhado com o config.php da HostGator. Existe só nestes
# dois lugares. Gere com: openssl rand -base64 32
MCP_INSTAGRAM_PONTE_SECRET=

# --- Backend de produção alternativo (só quando BACKEND=supabase) ---
# Credenciais PRÓPRIAS deste componente. Nunca reutilize o SUPABASE_URL
# / SUPABASE_KEY do .env da raiz do AMC-IA-Mobi: a regra de isolamento
# do CLAUDE.md exige credenciais separadas, e esta chave deve ter acesso
# apenas à tabela de tokens.
MCP_INSTAGRAM_SUPABASE_URL=
MCP_INSTAGRAM_SUPABASE_KEY=

# Opcional: o padrão é "mcp_instagram_tokens".
MCP_INSTAGRAM_SUPABASE_TABLE=

# Chave de cifragem do token (AES-256-GCM), 32 bytes em base64. É o que
# impede que um vazamento do banco, sozinho, entregue o token: banco e
# chave ficam em domínios de confiança diferentes. Gere UMA vez com:
#   python -c "from mcp_instagram.auth_instagram.crypto import generate_key_base64; print(generate_key_base64())"
# Trocar esta chave invalida o token guardado (basta reautorizar).
# Use uma chave PRÓPRIA, diferente da do mcp-linkedin.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
