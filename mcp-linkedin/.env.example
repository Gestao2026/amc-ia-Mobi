# mcp-linkedin. Variáveis de ambiente (exemplo)
#
# Este arquivo lista apenas os NOMES das variáveis. Nunca preencha
# valores reais aqui: copie para .env (fora do Git) em desenvolvimento
# local, ou cadastre como secret no painel do Render em produção.
#
# Este .env é exclusivo do mcp-linkedin. Nunca deve ser o mesmo .env do
# restante do AMC-IA-Mobi, e o restante do AMC-IA-Mobi nunca deve ler
# estas variáveis.

# --- Transporte (lido por resolve_run_config) ---
# stdio (padrão, uso local) ou streamable-http (produção).
# Em produção, PORT é fornecida automaticamente pelo Render.
MCP_TRANSPORT=
PORT=

# --- Base pública do serviço ---
# URL pública raiz onde este servidor responde, sem barra no final.
# Usada pelas DUAS camadas: é o issuer da Camada 1 e a origem do
# redirect_uri da Camada 2 (base + /oauth/linkedin/callback).
# Exemplo: https://mcp-linkedin.onrender.com
MCP_PUBLIC_BASE_URL=

# --- Camada 1: Claude.ai -> mcp-linkedin (Etapa 7A) ---
# Se ausentes, a Camada 1 fica desligada e /mcp responde sem exigir
# autorização (adequado só para uso local via stdio).
MCP_CLAUDE_CLIENT_ID=
MCP_CLAUDE_CLIENT_SECRET=

# --- Camada 2: mcp-linkedin -> LinkedIn, app Mobi (Etapa 7B) ---
# Client ID e Client Secret do aplicativo Mobi no LinkedIn Developer
# Portal. Se qualquer uma das duas (ou MCP_PUBLIC_BASE_URL) estiver
# ausente, a Camada 2 fica desligada e o servidor sobe sem ela.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Escopos solicitados, separados por espaço. Opcional: o padrão é
# "openid profile email" (o conjunto mínimo do OpenID Connect).
# Só inclua aqui escopos efetivamente APROVADOS no app Mobi: pedir um
# escopo não aprovado faz o LinkedIn recusar a autorização inteira.
LINKEDIN_SCOPES=

# Onde guardar o access token do LinkedIn:
#   windows   desenvolvimento local (Credential Manager / DPAPI).
#             Só funciona no Windows: a configuração é RECUSADA na
#             inicialização em qualquer outro sistema.
#   supabase  produção. Tabela dedicada, com o token cifrado no
#             aplicativo antes de sair daqui. Exige as três variáveis
#             abaixo.
#   memory    testes e uso efêmero. Não sobrevive a reinício.
# Opcional: o padrão é "windows" no Windows e "memory" nos demais.
LINKEDIN_TOKEN_STORE_BACKEND=

# --- Backend de produção do token (só quando BACKEND=supabase) ---
# Credenciais PRÓPRIAS deste componente. Nunca reutilize o SUPABASE_URL
# / SUPABASE_KEY do .env da raiz do AMC-IA-Mobi: a regra de isolamento
# do CLAUDE.md exige credenciais separadas, e esta chave deve ter
# acesso apenas à tabela de tokens.
MCP_LINKEDIN_SUPABASE_URL=
MCP_LINKEDIN_SUPABASE_KEY=

# Opcional: o padrão é "mcp_linkedin_tokens".
MCP_LINKEDIN_SUPABASE_TABLE=

# Chave de cifragem do token (AES-256-GCM), 32 bytes em base64.
# É o que impede que um vazamento do banco, sozinho, entregue o token:
# banco e chave ficam em domínios de confiança diferentes. Gere UMA vez
# com o comando abaixo e guarde como secret no Render:
#   python -c "from mcp_linkedin.auth_linkedin.crypto import generate_key_base64; print(generate_key_base64())"
# Trocar esta chave invalida o token guardado (basta reautorizar).
LINKEDIN_TOKEN_ENCRYPTION_KEY=

# URN da Página Mobilizando no LinkedIn. Ainda NÃO é lido por nenhum
# código: só será necessário nas ferramentas de leitura e publicação
# (etapa futura).
LINKEDIN_ORGANIZATION_URN=
