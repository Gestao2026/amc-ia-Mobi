# O CaptaHub devolve a UF em sigla; a lista do Airtable usa o nome por extenso.
# Os nomes aqui têm que bater LETRA POR LETRA com as opções da lista, senão o
# Airtable recusa a gravação. Estado que não estiver aqui não é escrito, e o
# script avisa em vez de falhar.
UF_POR_EXTENSO = {
    "AM": "AMAZONAS",
    "PA": "PARÁ",
    "MG": "MINAS GERAIS",
    "PE": "PERNAMBUCO",
    "BA": "BAHIA",
